#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
// Output Selection Behavior OUT_* keys
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define FNC  1
#define NUM  2
#define NAV  3
#define MOUSE 4
#define SAMEAPP LG(GRAVE)
#define PTAB LG(LA(LEFT))
#define NTAB LG(LA(RIGHT))
#define NWIN LA(TAB)
#define PWIN LS(LA(TAB))
#define DESK1 LC(N1)
#define DESK2 LC(N2)
#define DESK3 LC(N3)
#define DESK4 LC(N4)
#define MHOME LG(LEFT)
#define MEND LG(RIGHT)
#define NXTWO LG(G)
#define PRTSC LG(LS(N4))
//paste from sublime history cmd option v
#define SUBL1 LG(LA(V))
// vorssaint copy text from screen
#define VS_SCAN_CHARS LG(LA(LC(T)))
// open Zed
#define ZED LG(LA(LC(Z)))
// open Sublime merge
#define SUBMERGE LG(LA(LC(M)))
// open Iterm
#define ITERM LG(LA(LC(I)))
// open Slack
#define SLACK LG(LA(LC(S)))
// open Chrome
#define BROWSER LG(LA(LC(C)))

// TODO: use
// #define LR_DOWN LA(DOWN)
// #define LR_UP LA(UP)
// #define LR_ZOOM_IN LC(LS(EQUAL))
// #define LR_ZOOM_OUT LC(LS(MINUS))
// #define IDENT_LEFT LG(LEFT_BRACKET)
// #define IDENT_RIGHT LG(RIGHT_BRACKET)
// #define MOVE_TEXT_LEFT LC(LA(K))
// #define MOVE_TEXT_RIGHT LC(LA(L))

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };
};

/ {
    behaviors {
      hm: homerow_mods {
        compatible = "zmk,behavior-hold-tap";
        label = "homerow mods";
        #binding-cells = <2>;
        tapping_term_ms = <220>;
        flavor = "balanced";
        bindings = <&kp>, <&kp>;
      };
    };

    conditional_layers {
      compatible = "zmk,conditional-layers";
      tri_layer {
        if-layers = <2 3>;
        then-layer = <4>;
      };
    };

    keymap {
      compatible = "zmk,keymap";


// TODO: add DEL
      default_layer {
        display-name = "BASE";
// -----------------------------------------------------------------------------------------------------------------------------------------
// |  ESC     |    Q     |    W     |    E     |    R     |    T     |   |    Y     |    U     |    I     |    O     |    P     |   bksp   |
// | TAB/FN   |    A     |    S     |    D     |    F     |    G     |   |    H     |    J     |    K     |    L     |    '     |  ent/fn  |
// | SHIFT    |    Z     |    X     |    C     |    V     |    B     |   |    N     |    M     |    ,     |    .     |    /     |  shft/;  |
//                                  | OptEn    |   Cmd    |   NAV    |   |   NUM    |   spc    |   Ctl    |
        bindings = <
   &kp ESC       &kp Q       &kp W     &kp E      &kp R      &kp T           &kp Y     &kp U      &kp I      &kp O      &kp P         &kp BSPC
   &lt FNC TAB   &hm LSHFT A &kp S     &kp D      &kp F      &kp G           &kp H     &kp J      &kp K      &kp L      &hm RSHFT SQT &lt FNC RET
   &mt LSHFT RET &kp Z       &kp X     &kp C      &kp V      &kp B           &kp N     &kp M      &kp COMMA  &kp DOT    &kp FSLH      &mt RSHFT SEMI
                                       &kp LALT   &kp LGUI   &lt NAV DEL     &mo NUM   &kp SPC    &kp LCTRL
        >;
      };

      function_layer {
        display-name = "FUNC";

        bindings = <
// | Out TOG   |      F2 |   mute   |   V+       | play/stp |  @     |  |  F12     |  F7     |  F8      |  F9      | Print    | vs_scan_chars |
     &out OUT_TOG &kp F2  &kp C_MUTE &kp C_VOL_UP &kp C_PP    &none       &kp F12    &kp F7    &kp F8     &kp F9     &kp PRTSC  &kp VS_SCAN_CHARS
// | none      |    caps |   Prev   |   V-       |   Next   |   @p   |  | F11      |  F4     |  F5      |  F6      | Ins      | none     |
     &trans    &kp CAPS   &kp C_PREV &kp C_VOL_DN &kp C_NEXT  &none       &kp F11    &kp F4    &kp F5     &kp F6     &kp INS    &trans
// | ClearBLU  |   /Ble   |   Ble0  |   Ble1     |   Ble2   |   ---  |  | F10      |  F1     |  F2      |  F3      | ---      | none     |
     &bt BT_CLR  &trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &none      &kp F10    &kp F1    &kp F2     &kp F3     &trans     &trans
                                      &trans       &trans       &trans    &trans     &trans     &trans
        >;
      };

      num_layer {
        display-name = "NUM";
// ----------------------------------------------------------------------------------------------------------------------------------------
// |    `     |     !    |     +    |   [      |    ]     |    =     |   |     %    |     7    |    8     |    9    |     *    | /        |
// |    #     |     @    |     _    |   (      |    )     |    -     |   |     $    |     4    |    5     |    6    |     +    | ---      |
// |    ~     |     \    |     &    |   {      |    }     |    |     |   |     ^    |     1    |    2     |    3    |     -    | ---      |
//                                  |   ---    |   ---    |   ---    |   |   ---    |     0    |    .     |
        bindings = <
    &kp GRAVE  &kp EXCL   &kp PLUS   &kp LBKT   &kp RBKT   &kp EQUAL      &kp CARET  &kp N7     &kp N8     &kp N9    &kp KP_MULTIPLY &kp KP_DIVIDE
    &kp HASH   &kp AT     &kp UNDER  &kp LPAR   &kp RPAR   &kp MINUS      &kp PRCNT  &kp N4     &kp N5     &kp N6    &kp KP_PLUS     &none
    &kp TILDE  &kp BSLH   &kp AMPS   &kp LBRC   &kp RBRC   &kp PIPE       &kp DLLR   &kp N1     &kp N2     &kp N3    &kp KP_MINUS    &trans
                                     &trans     &trans     &trans         &trans     &kp N0     &kp DOT
        >;
      };


// NAV
// TODO: combo IDENT_ MOVE_TEXT
// TODO: light room
      nav_layer {
        display-name = "NAV";
// ---------------------------------------------------------------------------------------------------------------------------------
// |  SAMEAPP |    Tab-  |    Tab+  |   win+   |    win-  |   ---    |   |   Pgup   |   Home   |   Up     |  End    | ---      |   ---    |
// |   ---    |    Ctrl  |    Shft  |   alt    |    cmd   |   ---    |   |   Pgdw   |   Left   |   Down   |  Right  | ---      |   ---    |
// |   ---    |    ---   |   ---    |   nextw  |   subl1  |   ---    |   |    ---   |   desk1  |  desk2   |  desk3  | desk4    |   ---    |
//                                  |   ---    |   ---    |   ---    |   |    ---   |   ---    |   ---    |

        bindings = <
    &kp SAMEAPP &kp PTAB  &kp NTAB   &kp PWIN   &kp NWIN   &trans         &kp PG_UP  &kp MHOME  &kp UP     &kp MEND  &trans      &trans
    &trans     &kp LCTRL  &kp LSHFT  &kp LALT   &kp LGUI   &trans         &kp PG_DN  &kp LEFT   &kp DOWN   &kp RIGHT &trans      &trans
    &trans     &trans     &trans     &kp NXTWO  &kp SUBL1  &trans         &trans     &kp DESK1  &kp DESK2  &kp DESK3 &kp DESK4   &trans
                                     &trans     &trans     &trans         &trans     &none      &trans
        >;
      };

      mouse_layer {
        display-name = "MOUSE";
// ----------------------------------------------------------------------------------------------------------------------------------------
// |    ---   |    ---    |    up     |    ---   |    ---   |   ---   |   |    ---    |    ---    |    ScrUp  |    ---    |    ---    | ---      |
// |    ---   |    left   |    down   |    right |    ---   |   ---   |   |    ---    |   ScrLeft |   ScrDown |  ScrRight |    ---    | ---      |
// |    ---   |    ---    |    ---    |    ---   |    ---   |   ---   |   |  Browser  |    Zed    |   Merge   |  Iterm    |  Slack    | ---      |
//                                    |    ---   |    ---   |   ---   |   |    ---    |    ---    |    ---    |
        bindings = <
          &none   &none    &none          &mmv MOVE_UP   &none           &none   &none       &none          &msc SCRL_UP   &none           &none     &none
          &none   &none    &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &none   &none       &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_RIGHT &none     &none
          &none   &none    &none          &none          &none           &none   &kp BROSWER &kp ZED        &kp MERGE      &kp ITERM       &kp SLACK &none
                                          &none          &none           &none   &none       &none          &none
        >;
      };
    };
  };
